# Copy to .env — never commit real values. Loaded by app/core/config.py.
# Every setting in config.py is documented here; leave a value blank to use the
# default (or to fail fast if the field is required, like DATABASE_URL).

# Application
ENVIRONMENT=dev
LOG_LEVEL=INFO
LOG_JSON=true
API_PREFIX=v1
DEFAULT_LOCALE=lt
APP_NAME=viavitae-api
APP_VERSION=0.1.0

# Data stores
DATABASE_URL=postgresql+psycopg://ci:ci@localhost:5432/viavitae_test
REDIS_URL=redis://localhost:6379/0
STATEMENT_TIMEOUT_MS=5000
REQUEST_TIMEOUT_SECONDS=5.0

# Network
CORS_ALLOW_ORIGINS=https://viavitae.eu
TRUSTED_HOSTS=api.viavitae.eu

# Bitrix24 (EU instance)
BITRIX24_WEBHOOK_URL=

# Stripe (EU entity)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Paysera
PAYSERA_PROJECT_ID=
PAYSERA_SIGN_PASSWORD=

# AI pastoral assistant — self-hosted or EU SaaS only (ADR-007)
LLM_PROVIDER=self-hosted
LLM_BASE_URL=
LLM_API_KEY=
EMBEDDING_MODEL=bge-m3
RAG_TOP_K=6
AI_PUBLICATION_REQUIRES_APPROVAL=true

# Notifications
SMTP_URL=
SMS_PROVIDER_URL=
